{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stackchan-hermes.local/schemas/common.schema.json",
  "title": "StackChan protocol v1 common definitions",
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "deviceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "envelope": {
      "type": "object",
      "required": ["v", "type", "message_id", "sent_at_ms", "payload"],
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "message_id": {
          "$ref": "#/$defs/uuid"
        },
        "sent_at_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "request_id": {
          "$ref": "#/$defs/uuid"
        },
        "turn_id": {
          "$ref": "#/$defs/uuid"
        },
        "stream_id": {
          "$ref": "#/$defs/uuid"
        },
        "device_id": {
          "$ref": "#/$defs/deviceId"
        },
        "payload": {
          "type": "object"
        }
      },
      "additionalProperties": true
    }
  }
}
