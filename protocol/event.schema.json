{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stackchan-hermes.local/schemas/event.schema.json",
  "title": "StackChan protocol v1 event",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/envelope"
    },
    {
      "type": "object",
      "required": ["device_id"],
      "properties": {
        "type": { "const": "event" },
        "payload": { "$ref": "#/$defs/eventPayload" }
      }
    }
  ],
  "$defs": {
    "eventPayload": {
      "type": "object",
      "required": ["name", "data"],
      "properties": {
        "name": {
          "enum": [
            "touch.tap",
            "touch.long_press",
            "touch.stroke",
            "button.press",
            "wakeword.detected",
            "battery.changed",
            "wifi.changed",
            "audio.underrun",
            "audio.overflow",
            "camera.completed",
            "servo.error",
            "device.error"
          ]
        },
        "data": { "type": "object" }
      },
      "allOf": [
        {
          "if": { "properties": { "name": { "const": "touch.tap" } } },
          "then": { "properties": { "data": { "$ref": "#/$defs/touchTapData" } } }
        },
        {
          "if": { "properties": { "name": { "const": "touch.long_press" } } },
          "then": { "properties": { "data": { "$ref": "#/$defs/touchLongPressData" } } }
        },
        {
          "if": { "properties": { "name": { "const": "touch.stroke" } } },
          "then": { "properties": { "data": { "$ref": "#/$defs/touchStrokeData" } } }
        },
        {
          "if": { "properties": { "name": { "const": "button.press" } } },
          "then": { "properties": { "data": { "$ref": "#/$defs/buttonPressData" } } }
        },
        {
          "if": { "properties": { "name": { "const": "wakeword.detected" } } },
          "then": { "properties": { "data": { "$ref": "#/$defs/wakewordData" } } }
        },
        {
          "if": { "properties": { "name": { "const": "battery.changed" } } },
          "then": { "properties": { "data": { "$ref": "#/$defs/batteryData" } } }
        },
        {
          "if": { "properties": { "name": { "const": "wifi.changed" } } },
          "then": { "properties": { "data": { "$ref": "#/$defs/wifiData" } } }
        },
        {
          "if": {
            "properties": { "name": { "enum": ["audio.underrun", "audio.overflow"] } }
          },
          "then": { "properties": { "data": { "$ref": "#/$defs/audioBufferData" } } }
        },
        {
          "if": { "properties": { "name": { "const": "camera.completed" } } },
          "then": { "properties": { "data": { "$ref": "#/$defs/cameraCompletedData" } } }
        },
        {
          "if": {
            "properties": { "name": { "enum": ["servo.error", "device.error"] } }
          },
          "then": { "properties": { "data": { "$ref": "#/$defs/deviceFaultData" } } }
        }
      ],
      "additionalProperties": true
    },
    "touchTapData": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "integer", "minimum": 0, "maximum": 319 },
        "y": { "type": "integer", "minimum": 0, "maximum": 239 }
      },
      "additionalProperties": true
    },
    "touchLongPressData": {
      "type": "object",
      "required": ["x", "y", "duration_ms"],
      "properties": {
        "x": { "type": "integer", "minimum": 0, "maximum": 319 },
        "y": { "type": "integer", "minimum": 0, "maximum": 239 },
        "duration_ms": { "type": "integer", "minimum": 500, "maximum": 30000 }
      },
      "additionalProperties": true
    },
    "touchStrokeData": {
      "type": "object",
      "required": ["start_x", "start_y", "end_x", "end_y", "duration_ms"],
      "properties": {
        "start_x": { "type": "integer", "minimum": 0, "maximum": 319 },
        "start_y": { "type": "integer", "minimum": 0, "maximum": 239 },
        "end_x": { "type": "integer", "minimum": 0, "maximum": 319 },
        "end_y": { "type": "integer", "minimum": 0, "maximum": 239 },
        "duration_ms": { "type": "integer", "minimum": 1, "maximum": 30000 }
      },
      "additionalProperties": true
    },
    "buttonPressData": {
      "type": "object",
      "required": ["button"],
      "properties": {
        "button": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
        }
      },
      "additionalProperties": true
    },
    "wakewordData": {
      "type": "object",
      "properties": {
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": true
    },
    "batteryData": {
      "type": "object",
      "required": ["percent", "charging"],
      "properties": {
        "percent": { "type": "integer", "minimum": 0, "maximum": 100 },
        "charging": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "wifiData": {
      "type": "object",
      "required": ["connected"],
      "properties": {
        "connected": { "type": "boolean" },
        "rssi_dbm": { "type": "integer", "minimum": -127, "maximum": 0 }
      },
      "additionalProperties": true
    },
    "audioBufferData": {
      "type": "object",
      "required": ["stream_id", "dropped_packets"],
      "properties": {
        "stream_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "dropped_packets": { "type": "integer", "minimum": 1, "maximum": 65535 }
      },
      "additionalProperties": true
    },
    "cameraCompletedData": {
      "type": "object",
      "required": ["capture_id", "ok"],
      "properties": {
        "capture_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "ok": { "type": "boolean" },
        "error_code": { "$ref": "control.schema.json#/$defs/errorCode" }
      },
      "additionalProperties": true
    },
    "deviceFaultData": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Z0-9][A-Z0-9._-]*$"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
        }
      },
      "additionalProperties": true
    }
  }
}
